{
  "name": "species-database-app",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "install:linux": "bash scripts/install-linux.sh",
    "install:macos": "bash scripts/install-macos.sh",
    "install:windows11": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-windows11.ps1",
    "dev": "docker compose up --build",
    "dev:backend": "python backend/app.py",
    "dev:admin": "pnpm --filter admin dev",
    "dev:field": "pnpm --filter field dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "preview": "pnpm --filter admin preview",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  }
}
